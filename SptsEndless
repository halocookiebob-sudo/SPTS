    K = 1e3, M = 1e6, B = 1e9, T = 1e12,
    Qa = 1e15, Qi = 1e18, Sx = 1e21, Sp = 1e24,
    Oc = 1e27, No = 1e30, Dc = 1e33, Ud = 1e36, Dd = 1e39
}

local function t_n(s)
    if not s then return 0 end
    local n, u = tostring(s):gsub("%s+", ""):match("([%d%.]+)(%a*)$")
    n = tonumber(n) or 0
    if u == "" then return n end
    return um[u] and n * um[u] or n
end

