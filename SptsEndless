local function f2(tp)
	local o = w3[tp]
	if not o then return 0 end
	return f1(o.Text)
end

local function f3(tp, pw)
	local d = w[tp]
	if not d then return nil end
	local b,br = nil,-1
	for n,v in pairs(d) do
		local rq = f1(v.req)
		if pw >= rq and rq > br then b,br = n,rq end
	end
	return b,br
end

local function f4(tp, nm)
	local fd = ap:FindFirstChild(tp)
	if not fd then return nil end
	return fd:FindFirstChild(nm)
end

local function f5(ar)
	if not ar then return false end
	local ch = pl.Character
	if not ch then return false end
	local hr = ch:FindFirstChild("HumanoidRootPart")
	if not hr then return false end
	local cf
	if ar:IsA("BasePart") then cf = ar.CFrame
	else
		local pt = ar.PrimaryPart or ar:FindFirstChildWhichIsA("BasePart")
		if pt then cf = pt.CFrame end
	end
	if cf then
		hr.CFrame = cf + Vector3.new(0,5,0)
		return true, cf + Vector3.new(0,5,0)
	end
	return false
end

local function f6()
	local ms = f2("MovementSpeed")
	local jf = f2("JumpForce")
	local wi,idx = nil,1
	for i,v in ipairs(w1) do
		if ms >= v.ms and jf >= v.jf then wi,idx = v,i else break end
	end
	if wi then rs:FireServer({{"EquipWeight_Request",idx}}) end
end

