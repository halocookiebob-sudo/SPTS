local function sc()
        if not writefile then return false end
        ef()
        if mf and mf.Visible then
                cf.up = {X = mf.Position.X.Offset, Y = mf.Position.Y.Offset}
        end
        local w, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12
        if cf.sv then
                w, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12 = cf.sv:GetComponents()
        end
        local sv = w and {w, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12} or nil
        local w13 = {id = id, nm = nm, kb = cf.kb, st = cf.st, aw = cf.aw, as = cf.as, tb = cf.tb, sv = sv, up = cf.up, fm = cf.fm}
        local w14, w15 = pcall(function() writefile(fp, hs:JSONEncode(w13)) end)
        if w14 then lt = tick(); vp = false; return true end
        vp = false
        return false
end

local function ds()
        if vp then return end
        vp = true
        local w = tick() - lt
        if w >= .1 then
                sc()
        else
                task.delay(.1 - w, function() if vp then sc() end end)
        end
end

local function lc()
        if not readfile or not isfile or not isfile(fp) then return false end
        local w, w2 = pcall(function() return hs:JSONDecode(readfile(fp)) end)
        if not w or not w2 or w2.id ~= id then return false end
        cf.kb = w2.kb or "G"
        cf.st = w2.st
        cf.aw = w2.aw or false
        cf.as = w2.as ~= nil and w2.as or true
        cf.tb = w2.tb or "Auto Farm"
        if w2.sv and #w2.sv == 12 then
                cf.sv = CFrame.new(unpack(w2.sv))
        end
        cf.up = w2.up
        cf.fm = w2.fm
        return true
end

