local cf_n = "eSPTS_Config.json"

local function sv_cg()
    if not writefile then return end
    local sd = nil
    if sv_ps then
        sd = {
            X  = sv_ps.X,  Y  = sv_ps.Y,  Z  = sv_ps.Z,
            RX = sv_ps.RightVector.X, RY = sv_ps.RightVector.Y, RZ = sv_ps.RightVector.Z,
            UX = sv_ps.UpVector.X,    UY = sv_ps.UpVector.Y,    UZ = sv_ps.UpVector.Z,
            BX = sv_ps.LookVector.X,  BY = sv_ps.LookVector.Y,  BZ = sv_ps.LookVector.Z
        }
    end
    local j = ht_svc:JSONEncode({
        kb = cg.kb.Name,
        st = sl_tp,
        aw = a_wt,
        as = cg.as,
        sp = sd,
        te = (sl_tp ~= nil)
    })
    writefile(cf_n, j)
end

local function ld_cg()
    if not readfile or not isfile or not isfile(cf_n) then return false end
    local ok, d = pcall(function()
        return ht_svc:JSONDecode(readfile(cf_n))
    end)
    if not ok or not d then return false end

    if d.kb and Enum.KeyCode[d.kb] then
        cg.kb = Enum.KeyCode[d.kb]
    else
        cg.kb = Enum.KeyCode.G
    end
    a_wt  = d.aw or false
    cg.as = (d.as ~= nil) and d.as or true

    if d.sp then
        local s = d.sp
        sv_ps = CFrame.fromMatrix(
            v3(s.X, s.Y, s.Z),
            v3(s.RX, s.RY, s.RZ),
            v3(s.UX, s.UY, s.UZ),
            v3(s.BX, s.BY, s.BZ)
        )
    end
    return true, d
end

local function a_sv()
    if cg.as then sv_cg() end
end

