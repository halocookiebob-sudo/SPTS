local function sc()
    if writefile then
        local w = nil
        if sv then
            w = {
                X = sv.X, Y = sv.Y, Z = sv.Z,
                RX = sv.RightVector.X, RY = sv.RightVector.Y, RZ = sv.RightVector.Z,
                UX = sv.UpVector.X, UY = sv.UpVector.Y, UZ = sv.UpVector.Z,
                BX = sv.LookVector.X, BY = sv.LookVector.Y, BZ = sv.LookVector.Z
            }
        end
        cfg.FarmSettings = {
            FistStrength = gcs("FistStrength"),
            BodyToughness = gcs("BodyToughness"),
            PsychicPower = gcs("PsychicPower"),
            JumpForce = gcs("JumpForce"),
            MovementSpeed = gcs("MovementSpeed")
        }
        local w2 = hs:JSONEncode({
            Keybind = cfg.Keybind.Name,
            SelectedTraining = st,
            AutoWeightActive = aw,
            AutoSaveEnabled = cfg.AutoSaveEnabled,
            SavedPosition = w,
            FarmSettings = cfg.FarmSettings,
            TrainingEnabled = (st ~= nil)
        })
        writefile(cfn, w2)
    end
end

local function lc()
    if readfile and isfile and isfile(cfn) then
        local w, w2 = pcall(function()
            return hs:JSONDecode(readfile(cfn))
        end)
        if w and w2 then
            if w2.Keybind and Enum.KeyCode[w2.Keybind] then
                cfg.Keybind = Enum.KeyCode[w2.Keybind]
            else
                cfg.Keybind = Enum.KeyCode.G
            end
            cfg.SelectedTraining = w2.SelectedTraining
            cfg.AutoWeightActive = w2.AutoWeightActive or false
            cfg.AutoSaveEnabled = w2.AutoSaveEnabled ~= nil and w2.AutoSaveEnabled or true
            cfg.FarmSettings = w2.FarmSettings or {}
            cfg.TrainingEnabled = w2.TrainingEnabled or false
            if w2.SavedPosition then
                local w3 = w2.SavedPosition
                sv = CFrame.fromMatrix(
                    Vector3.new(w3.X, w3.Y, w3.Z),
                    Vector3.new(w3.RX, w3.RY, w3.RZ),
                    Vector3.new(w3.UX, w3.UY, w3.UZ),
                    Vector3.new(w3.BX, w3.BY, w3.BZ)
                )
                if pt then pt.Text = "Position loaded from config!" end
            end
            return true
        end
    end
    return false
end

local function soc()
