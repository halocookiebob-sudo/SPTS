local function f1(v)
	if not v then return 0 end
	v = tostring(v):gsub("%s+","")
	local n,u = v:match("([%d%.]+)(%a*)$")
	n = tonumber(n) or 0
	if u == "" then return n end
	for _,x in ipairs(w2) do if x[1]==u then return n*x[2] end end
	return n
end

