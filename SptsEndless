local function f9()
	if not readfile or not isfile or not isfile(c1) then return false end
	local ok,d = pcall(function() return hs:JSONDecode(readfile(c1)) end)
	if ok and d then
		if d.Keybind and Enum.KeyCode[d.Keybind] then c.Keybind=Enum.KeyCode[d.Keybind]
		else c.Keybind=Enum.KeyCode.G end
		c.SelectedTraining = d.SelectedTraining
		c.AutoWeightActive = d.AutoWeightActive or false
		c.AutoSaveEnabled = d.AutoSaveEnabled ~= nil and d.AutoSaveEnabled or true
		c.FarmSettings = d.FarmSettings or {}
		c.TrainingEnabled = d.TrainingEnabled or false
		if d.SavedPosition then
			local sp = d.SavedPosition
			s4 = CFrame.fromMatrix(
				Vector3.new(sp.X,sp.Y,sp.Z),
				Vector3.new(sp.RX,sp.RY,sp.RZ),
				Vector3.new(sp.UX,sp.UY,sp.UZ),
				Vector3.new(sp.BX,sp.BY,sp.BZ)
			)
		end
		return true
	end
	return false
end

