    local bf = m_f(ud(1, 0, 0, 55), nil, c_bas)
    m_c(bf, 10)
    bf.Parent = fm_pg

    local bt = m_b(bf, ud(1, 0, 1, 0), nil, dn[ct])
    fm_bs[ct] = {f = bf, b = bt}

    bt.MouseButton1Click:Connect(function()
        if sl_tp == ct then
            sl_tp, sl_bt, ac_ob, ar_cf = nil, nil, nil, nil
            bf.BackgroundColor3 = c_bas
            bt.TextColor3 = c_txt
            fm_tx.Text = "No active training"
            a_sv()
            return
        end

        if sl_bt then
            sl_bt.f.BackgroundColor3 = c_bas
            sl_bt.b.TextColor3 = c_txt
        end

        sl_tp = ct
        sl_bt = {f = bf, b = bt}
        bf.BackgroundColor3 = c_on
        bt.TextColor3 = c_wht

        local pw  = g_s(ct)
        local an  = f_b(ct, pw)

        if not an then
            fm_tx.Text = dn[ct] .. " - No available area"
            ar_cf = nil
            a_sv()
            return
        end

        local ao = g_a(ct, an)
        ac_ob = ao

        if not ao then
            fm_tx.Text = "Area '" .. an .. "' not found!"
            ar_cf = nil
            a_sv()
            return
        end

        local ok, cf = t_p(ao)
        if ok then
            ar_cf  = cf
            fm_tx.Text = dn[ct] .. " - Area: " .. an .. " (req " .. ar[ct][an].r .. ")"
        else
            fm_tx.Text = "Teleport failed!"
        end
        a_sv()
    end)

    bt.MouseEnter:Connect(function()
        if sl_tp ~= ct then
            tw(bf, {BackgroundColor3 = c_hov})
        end
    end)

    bt.MouseLeave:Connect(function()
        if sl_tp ~= ct then
            tw(bf, {BackgroundColor3 = c_bas})
        end
    end)
end

