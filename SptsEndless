local function g_s(t)
    local o = sp[t]
    return o and t_n(o.Text) or 0
end

local function f_b(t, p)
    local d = ar[t]
    if not d then return nil end
    local b, br = nil, -1
    for k, v in pairs(d) do
        local rq = t_n(v.r)
        if p >= rq and rq > br then
            b, br = k, rq
        end
    end
    return b
end

local function g_a(t, n)
    local f = ar_p:FindFirstChild(t)
    return f and f:FindFirstChild(n) or nil
end

local function t_p(a)
    if not a then return false end
    local c = pl.Character
    if not c then return false end
    local h = c:FindFirstChild("HumanoidRootPart")
    if not h then return false end
    local pt = a:IsA("BasePart") and a
        or (a.PrimaryPart or a:FindFirstChildWhichIsA("BasePart"))
    if pt then
        local cf = pt.CFrame + v3(0, 5, 0)
        h.CFrame = cf
        return true, cf
    end
    return false
end

local function e_w()
    local ms, jf = g_s("MovementSpeed"), g_s("JumpForce")
    local idx = 0
    for i, v in ipairs(wl) do
        if ms >= v[1] and jf >= v[2] then
            idx = i
        else
            break
        end
    end
    if idx > 0 then
        rm_evt:FireServer({{"EquipWeight_Request", idx}})
    end
end

